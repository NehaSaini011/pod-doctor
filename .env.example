# Copy this file to ".env" and paste your key.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Chat model used by the agent. If you get a "model not found" or quota error,
# try another current Flash model name from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Embedding model used for RAG over the runbooks
EMBED_MODEL=gemini-embedding-001

# Cluster the agent is allowed to inspect (created by scripts/cluster.py)
KUBE_CONTEXT=kind-pod-doctor
NAMESPACE=shop

# live = real kubectl on this laptop. snapshot = read data/cluster_snapshot.json (the deployed site)
CLUSTER_MODE=live

# Only needed on the public website (set these in Streamlit Secrets instead)
# APP_PASSWORD=
# MAX_RUNS_PER_SESSION=5
